# Token del bot obtenido desde Discord Developer Portal (NUNCA versionar el token real)
DISCORD_BOT_TOKEN=

# ID opcional de servidor de desarrollo para sincronizar slash commands al instante
DISCORD_DEV_GUILD_ID=

# Permitir suscripciones por mensaje directo (DM); en servidores siempre gestionan sus propios admins
ALLOW_DM_SUBSCRIPTIONS=false

# Mostrar miniatura por URL directa del feed cuando exista en los Embeds de alertas
DISCORD_SHOW_THUMBNAILS=true

# Conexión con el servicio web (feed.raupulus.dev)
WEB_API_BASE_URL=http://127.0.0.1:8000
WEB_API_TIMEOUT_SECONDS=10

# WebSocket público de Laravel Reverb
REVERB_WS_URL=ws://127.0.0.1:8080
REVERB_APP_KEY=beacon-sift-public-key
REVERB_CHANNEL=beacon.news

# Persistencia local SQLite y formato horario
BOT_DB_PATH=data/bot.db
BOT_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
